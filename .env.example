# Copy file này thành .env.local rồi điền giá trị thật (.env.local đã được gitignore)

# URL môi trường test (mặc định: dev)
E2E_BASE_URL=https://example.com

# Tài khoản admin trên môi trường dev — dùng cho auth setup và test đăng nhập
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Độ trễ giữa mỗi thao tác (ms)
# 0 = chạy hết tốc độ. Đặt 300–1000 kèm `npm run test:headed` để xem test chạy
E2E_SLOW_MO=0
